* text=auto
*.cpp text eol=lf
*.h text eol=lf
*.cs text eol=lf
*.ini text eol=lf
*.md text eol=lf
*.py text eol=lf
*.ps1 text eol=crlf
*.uasset filter=lfs diff=lfs merge=lfs -text
*.umap filter=lfs diff=lfs merge=lfs -text

# Third-party source art kept alongside imported content
*.fbx filter=lfs diff=lfs merge=lfs -text
*.tga filter=lfs diff=lfs merge=lfs -text
*.jpg filter=lfs diff=lfs merge=lfs -text
*.wav filter=lfs diff=lfs merge=lfs -text

# Design source art and evidence bundles (large binaries; GitHub rejects plain objects over 100 MB)
design/**/*.zip filter=lfs diff=lfs merge=lfs -text
design/**/*.blend filter=lfs diff=lfs merge=lfs -text
design/**/*.blend1 filter=lfs diff=lfs merge=lfs -text
design/**/*.glb filter=lfs diff=lfs merge=lfs -text
design/**/*.png filter=lfs diff=lfs merge=lfs -text
